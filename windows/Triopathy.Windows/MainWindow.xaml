<Window x:Class="Triopathy.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{Binding Title}" Width="1160" Height="850" MinWidth="1000" MinHeight="730" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="#EAEDE5" Padding="12,4">
   <MenuItem Header="_File"><MenuItem Header="Load context seed…" Click="LoadContextClick" IsEnabled="{Binding CanEdit}" InputGestureText="Ctrl+Shift+O"/><MenuItem Header="Remove loaded context" Command="{Binding RemoveContextCommand}"/><Separator/><MenuItem Header="Save as JSON…" Click="SaveJsonClick" IsEnabled="{Binding CanExport}"/><MenuItem Header="Save as TXT…" Click="SaveTextClick" IsEnabled="{Binding CanExport}"/><Separator/><MenuItem Header="Clear conversation" Command="{Binding ClearCommand}"/><MenuItem Header="Exit" Click="ExitClick"/></MenuItem>
   <MenuItem Header="_View"><MenuItem Header="Larger discussion text" Click="LargerClick" InputGestureText="Ctrl++"/><MenuItem Header="Smaller discussion text" Click="SmallerClick" InputGestureText="Ctrl+-"/><MenuItem Header="Reset text size" Click="ResetFontClick" InputGestureText="Ctrl+0"/></MenuItem>
   <MenuItem Header="_Connections" Click="ConnectionsClick" IsEnabled="{Binding CanEdit}"/>
  </Menu>
  <Grid Margin="28,22,28,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="CONVERSATION ROOM" FontSize="11" FontWeight="SemiBold" Foreground="#738479"/><TextBlock Text="Triopathy" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,5"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}"/></StackPanel>
    <Button Grid.Column="1" Content="Connections…" Click="ConnectionsClick" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0" AutomationProperties.AutomationId="ConnectionsButton"/>
   </Grid>
   <ItemsControl Grid.Row="1" ItemsSource="{Binding Participants}" Margin="0,0,0,18"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#DBE1D9" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,8,6" ToolTip="{Binding Detail}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding Indicator}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Muted}" Margin="7,1,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Border Grid.Row="2" Background="White" BorderBrush="#DBE1D9" BorderThickness="1" CornerRadius="12"><Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasMessages}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="A question. Several perspectives." FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Start with a seed below, or load a conversation to continue." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,5"/><TextBlock Text="Each reachable participant speaks once per round." Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
    <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16" Visibility="{Binding HasMessages, Converter={StaticResource BoolVisibility}}"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F7F8F4" BorderBrush="{Binding Color}" BorderThickness="3,0,0,0" Padding="16,12" Margin="0,0,0,12"><StackPanel><DockPanel Margin="0,0,0,7"><TextBlock Text="{Binding Timestamp}" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding Color}" FontSize="12"/></DockPanel><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid></Border>
   <StackPanel Grid.Row="3" Margin="0,20,0,0">
    <Expander x:Name="WebAccessExpander" Header="Web access" Margin="0,0,0,10" IsEnabled="{Binding CanEdit}"><StackPanel Margin="0,8,0,6">
     <CheckBox Content="Search the web and share sources with all participants" IsChecked="{Binding WebEnabled}" IsEnabled="{Binding CanEdit}"/>
     <TextBlock Text="The search query is sent to DuckDuckGo. Up to three public pages are read before the conversation." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,6"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock Text="Search query (blank uses your seed)" FontSize="11"/><TextBox Text="{Binding WebQuery, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Page URLs (optional; one per line)" FontSize="11"/><TextBox Text="{Binding WebUrls, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="46" VerticalScrollBarVisibility="Auto"/></StackPanel>
     </Grid>
     <ItemsControl ItemsSource="{Binding WebSources}" Visibility="{Binding HasWebSources, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Margin="0,2"><Hyperlink NavigateUri="{Binding Url}" RequestNavigate="WebSourceNavigate"><Run Text="{Binding Title}"/></Hyperlink></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Expander>
    <DockPanel Margin="0,0,0,8"><TextBlock Text="CONVERSATION SEED" Style="{StaticResource SectionLabel}" Margin="0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasContext, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding ContextLabel}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="Remove" Command="{Binding RemoveContextCommand}" Padding="8,3" Margin="8,0,0,0"/></StackPanel></DockPanel>
    <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="86" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="SeedInput"/>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Rounds" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding RoundChoices}" SelectedItem="{Binding Rounds}" Width="64" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="RoundSelector"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0"><Button Content="Refresh hosts" Command="{Binding RefreshCommand}"/><Button Content="Clear" Command="{Binding ClearCommand}"/></StackPanel><Button Grid.Column="3" Content="{Binding StartLabel}" Command="{Binding StartCommand}" Background="#315F55" Foreground="White" BorderBrush="#315F55" FontWeight="SemiBold" Padding="22,11" Margin="0" AutomationProperties.AutomationId="StartButton"/></Grid>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" AutomationProperties.AutomationId="StatusText"/>
   </StackPanel>
  </Grid>
 </DockPanel>
</Window>
